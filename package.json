{
  "name": "dsh-screen",
  "version": "0.7.0",
  "description": "DSH 学习辅助插件：持续观察屏幕并记笔记，支持摄像头取帧、本地语音转写与朗读",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanghao-lumen/dsh-screen.git"
  },
  "homepage": "https://github.com/zhanghao-lumen/dsh-screen#readme",
  "bugs": {
    "url": "https://github.com/zhanghao-lumen/dsh-screen/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "native/bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "screen",
    "vision",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test:ci": "DSH_SCREEN_FAKE_CAPTURE=1 node test/host.test.mjs && node test/client.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1"
  }
}
